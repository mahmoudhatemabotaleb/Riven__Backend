# Database
DATABASE_URL=postgresql://user:password@host:5432/rivendb

# Or for local SQL Server:
# ConnectionStrings__DefaultConnection=Server=localhost;Database=RivenBackendDb;Trusted_Connection=True;TrustServerCertificate=True

# Environment
ASPNETCORE_ENVIRONMENT=Development

# JWT
Jwt__Key=your-secret-key-minimum-32-characters-long
Jwt__Issuer=RivenBackend
Jwt__Audience=RivenBackendUsers

# Email (SMTP)
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=
Email__Password=

# Twilio (SMS OTP)
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__PhoneNumber=
